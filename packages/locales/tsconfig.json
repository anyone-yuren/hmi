{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@gbeata/ts-config/react-app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "types": [],
    "paths": {
      "@/*": ["src/*"],
      "#/*": ["types/*"]
    }
  },
  "include": ["locales/**/*.ts", "locales/**/*.d.ts", "locales/**/*.json", "index.ts", "types/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.js"]
}
