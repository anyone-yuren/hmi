{
  "name": "hmi-4.0",
  "version": "0.0.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "bootstrap": "pnpm install",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "turbo run stub",
    "build": "rm -rf ./@gbeata  && turbo build --no-cache --force",
    "dev:dep": "pnpm run dev --filter @gbeata/deployer",
    "build:dep": "pnpm run build --filter @gbeata/deployer",
    "docs:build": "turbo docs:build --filter gbeata",
    "build:admin": "pnpm run build --filter gbeata-admin",
    "dev": "turbo run dev --parallel --no-cache",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky install",
    "commit": "git add -A && git cz",
    "release": "cross-env GITLAB_TOKEN=PiXbZ5JJpvVdzsr1QnKN release-it ",
    "clean": "node ./scripts/clean.mjs",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "clean:node-modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "clean:turbo-cache": "turbo run clean && rimraf node_modules",
    "create:app": "plop app",
    "dev:customer": "pnpm -F @gbeata/customer run dev",
    "dev:3d": "pnpm -F @gbeata/twin run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
